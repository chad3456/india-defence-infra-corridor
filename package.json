{
  "name": "bharat-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "India Defence & Infrastructure Tracker \u2014 curated, source-cited data on defence, infrastructure, trade and manufacturing since 2001.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "etl": "tsx scripts/etl/run.ts",
    "etl:dry": "tsx scripts/etl/run.ts --dry-run",
    "map:refresh": "tsx scripts/etl/refresh-map.ts",
    "map:refresh:dry": "tsx scripts/etl/refresh-map.ts --dry-run",
    "sources:verify": "tsx scripts/etl/verify-sources.ts",
    "satp:probe": "tsx scripts/etl/probe-satp.ts",
    "sources:probe": "tsx scripts/etl/probe-sources.ts",
    "pdf:read": "tsx scripts/pdf-read.ts",
    "sheet:read": "tsx scripts/sheet-read.ts",
    "workbooks:probe": "tsx scripts/etl/probe-workbooks.ts",
    "security:check": "tsx scripts/check-curated.ts",
    "docs:sync": "tsx scripts/docs/sync-tables.ts",
    "validate": "tsx scripts/validate.ts",
    "registry:audit": "tsx scripts/audit-registry.ts",
    "test": "npm run validate && npm run registry:audit && npm run test:schema && npm run test:ingest && npm run test:security && npm run test:epistemic && npm run test:localisation && npm run test:trai && npm run test:pdf && npm run test:sheets && npm run security:check && npm run test:docs && npm run db:seed-check && npm run typecheck",
    "db:push": "tsx scripts/db/sync.ts push",
    "db:pull": "tsx scripts/db/sync.ts pull",
    "db:check": "tsx scripts/db/sync.ts check",
    "prebuild": "tsx scripts/db/sync.ts pull",
    "test:schema": "node scripts/test-schema.mjs",
    "db:seed-sql": "tsx scripts/db/seed-sql.ts > supabase/seed.sql",
    "db:seed-check": "tsx scripts/db/seed-sql.ts > /tmp/seed.check.sql && diff -q supabase/seed.sql /tmp/seed.check.sql",
    "test:ingest": "tsx scripts/test-ingest.ts",
    "test:docs": "tsx scripts/test-docs.ts",
    "test:security": "tsx scripts/test-security.ts",
    "test:pdf": "tsx scripts/test-pdf.ts",
    "geo:build": "tsx scripts/geo/build-gazetteer.ts",
    "test:epistemic": "tsx scripts/test-epistemic.ts",
    "test:localisation": "tsx scripts/test-localisation.ts",
    "test:trai": "tsx scripts/test-trai-areas.ts",
    "test:sheets": "tsx scripts/test-sheets.ts",
    "wdi:probe": "tsx scripts/etl/probe-wdi.ts",
    "wdi:promote": "tsx scripts/docs/promote-wdi.ts",
    "who:probe": "tsx scripts/etl/probe-who.ts",
    "pdfs:probe": "tsx scripts/etl/probe-pdfs.ts",
    "trade:probe": "tsx scripts/etl/probe-trade.ts",
    "mobility:probe": "tsx scripts/etl/probe-mobility.ts",
    "mobility:ingest": "tsx scripts/etl/ingest-mobility.ts",
    "ogd:probe": "tsx scripts/etl/probe-ogd.ts",
    "vande:probe": "tsx scripts/etl/probe-vande.ts",
    "trade:universe": "tsx scripts/etl/build-hs6-universe.ts",
    "trade:ingest": "tsx scripts/etl/ingest-trade.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.58.0",
    "d3-array": "^3.2.4",
    "d3-geo": "^3.1.1",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "next": "^16.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.5",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/d3-array": "^3.2.1",
    "@types/d3-geo": "^3.1.0",
    "@types/d3-scale": "^4.0.8",
    "@types/d3-shape": "^3.1.6",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "pdfjs-dist": "^6.2.108",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "xlsx": "^0.18.5",
    "zod": "^3.24.1"
  },
  "engines": {
    "node": ">=20"
  }
}
