# All optional. The site builds and runs with none of these set — chart data
# lives in versioned JSON and the news tracker falls back to data/live/news.json.
#
# Set these only to enable the continuously-refreshing Postgres-backed tracker.

# Project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable (anon) key — read-only, safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — WRITE access. Used only by the ETL.
# Never expose this to the browser and never commit it.
# In GitHub, add it as a repository secret; in Vercel, as a server-side env var.
SUPABASE_SERVICE_ROLE_KEY=
