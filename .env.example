# All optional. The site builds and runs with none of these set — chart data is
# committed as JSON and the news tracker falls back to data/live/news.json.
#
# Set them to make Postgres the live backend. Everything lives in the
# `bharat_tracker` schema; nothing touches `public`, so this is safe in a
# database shared with other projects.
#
# The Vercel Supabase integration injects SUPABASE_URL / SUPABASE_ANON_KEY
# automatically — the app reads either naming, so you may not need to set these
# by hand on Vercel at all.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Write access. Used only by the ETL and the provisioning workflow.
# Never expose to the browser; never commit.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string, used by the provisioning workflow to apply
# the migration. Supabase -> Settings -> Database -> Connection string (URI),
# or the POSTGRES_URL_NON_POOLING value from the Vercel integration.
SUPABASE_DB_URL=
