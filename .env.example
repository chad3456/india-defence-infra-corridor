# All optional. The site builds and runs with none of these set — chart data is
# committed as JSON and the news tracker falls back to data/live/news.json.
#
# Set them to make Postgres the live backend. Everything lives in the
# `bharat_tracker` schema; nothing touches `public`, so this is safe in a
# database shared with other projects.
#
# The Vercel Supabase integration injects SUPABASE_URL / SUPABASE_ANON_KEY
# automatically — the app reads either naming, so you may not need to set these
# by hand on Vercel at all.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Write access. Used only by the ETL and the provisioning workflow.
# Never expose to the browser; never commit.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string. This alone provisions the database via the
# "Provision database" GitHub Action — schema and seed both.
# Supabase -> Settings -> Database -> Connection string (URI), with your real
# password substituted. Same value as POSTGRES_URL_NON_POOLING on Vercel.
SUPABASE_DB_URL=

# X (Twitter) API bearer token — OPTIONAL.
# X has no free read tier: the v2 free plan is write-only, and reading timelines
# needs Basic ($200/month at the time of writing) or above. Without this the X
# connector reports itself inactive and the pipeline carries on; the PIB, PMO
# and ministry feeds carry the same announcements from the primary source.
# Handles are configured in lib/sources.ts (X_HANDLES) — never post content.
X_BEARER_TOKEN=
