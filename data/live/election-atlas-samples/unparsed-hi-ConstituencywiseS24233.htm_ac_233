<!DOCTYPE HTML>
<html>
<head>
    <title>Assembly Election 2019 - Election Commission of India</title>
    <meta http-equiv='Content-Language' content='hi' />
    <meta http-equiv='Content-Type' content='text/html; charset=UTF-8' />
    <meta http-equiv='X-UA-Compatible' content='IE=9' />
    <meta http-equiv='Cache-Control' content='no-cache, no-store, must-revalidate' />
    <meta http-equiv='Pragma' content='no-cache' />
    <meta http-equiv='Expires' content='0' />
    <meta http-equiv='refresh' content='300' />  

    <style type='text/css'>
          body{
        font-family: Verdana;Arial, Helvetica, sans-serif; font-size: 13px;
        width: 1024px;
        padding: 0px;
        margin: 0 auto;
        background:#105980;
    }
    .wrap-sec{
        text-align:center;
                width:1024px;
    }
    .tabc{
        background-color: #fff;
        width:1024px;
    }
    
    .tabc h1{
         font-size: 26px;
         font-weight: bold;
    }
    .tabc h4{
        font-size: 16px;
        font-weight: bold;
        margin:0;
    }
        .ctl00_Menu1_0 {
            background-color: white;
            visibility: hidden;
            display: none;
            position: absolute;
            left: 0px;
            top: 0px;
        }

        .ctl00_Menu1_1 {
            color: #fff;
            font-family: Verdana;
            text-decoration: none;
            background:#e91e63;
            padding:10px 15px;  
        }
        .disclaimer-wide {
            margin: 10px;
            padding: 10px;
            text-align: center;
            width: auto;
            float: none;
            border:1px solid #ddd;
            background:#f4f4f4;
        }
        .ctl00_Menu1_1:hover{
            background:#105980;
        }
        .ctl00_Menu1_2 {
            color: #7C6F57;
            background-color: transparent;
            font-family: Verdana;
        }

        .ctl00_Menu1_3 {
            text-decoration: none;
        }

        .ctl00_Menu1_4 {
            padding: 2px 5px 2px 5px;
        }

        .ctl00_Menu1_12 {
            color: white;
        }

        .ctl00_Menu1_13 {
            background-color: #7c6f57;
            color: white;
        }

        .ctl00_Menu1_14 {
            color: white;
        }

        .ctl00_Menu1_15 {
            background-color: #7c6f57;
            color: white;
        }
        .table-party{
          margin:0 auto;
          width: 100%;
          font-family: Verdana;
          border: 1px solid #ddd;
          font-weight:normal; 
        }
        .table-party tr td, .table-party tr th{
            padding:10px 15px;
        }
        .table-party tr th{
            color: #fff;
            background:#105980;
        }
        .table-party p{
            padding:5px;
            margin:0;
            font-size:16px;
        }
        .text-uper{
            text-transform:uppercase;
        }
             .refresh{
                background: linear-gradient(to right, rgb(179, 220, 237) 0%, rgb(41, 184, 229) 50%, rgb(105, 146, 162) 100%);
                padding-bottom:15px;
                width:100%;
                padding:5px 15px;
                max-width:994px;
                position:fixed;
                top: 0;
                z-index: 999;
                
            }      
            .refresh-lft{
                float:left;
            }    
            .refresh-rgt{
                float:right;
                text-align:right;
            }
            .refresh-rgt, .refresh-rgt a{
                color:#fff;
                text-decoration:none;
            }  
            .refresh-rgt a:hover{
                    color: #e91e63;
            }
            .refresh-lft button{
                background: #e91e63;
                font-weight: bold;
                color: #fff;
                padding: 10px 15px;
                box-shadow: none;
                border: none;
                cursor: pointer;
                float: left;
                margin-right: 5px;
            }
            .refresh-lft button:hover{
                background: #105980;
            }
            .clear{
                clear:both;
            }

            /*span.textmsg {
                float: left;
                padding: 10px;
                font-size: 10px;
                color: #105980;
                font-weight: bold;
            }*/
            .aclink {
                margin-top: 43px;
                margin-right: -110px;
            }
            .btn-blank{
                 float:right; padding-right:0;font-size:15px; margin-top: 10px;
    margin-bottom: 10px;
    margin-right: 10px;
            }
            .btn-blank a{
               text-decoration:none; border:1px solid #105980; padding:4px 10px; color:#105980;     
            }            
            .btn-blank a:hover{
                   background-color:#105980; color:#fff;     
            }             
         .disclaimer-wide {
                margin: 0 auto 0.5rem;
                padding: 5px;
                text-align: center;
                width: 88.50%;
                float: none;
                border: 1px solid #ddd;
                background: #f4f4f4;
                font-weight: 900;
                line-height: 21px;
                position: relative;
                font-size: 12px;
            }
@media screen and (max-width: 1023px) {
 .wrap-sec, .refresh, body, .tabc {
    width: 100%;
}
body{
    padding:0 15px;
}
.refresh-rgt {
    padding-right: 25px;
}
}
.refresh-rft{
                background: #e91e63;
                font-weight: bold;
                color: #fff;
                padding: 10px 15px;
                box-shadow: none;
                border: none;
                cursor:pointer;
                float:right;
            }
  .disclmr h3 {margin: 0 auto 0.25rem;} 
.gap-between{margin-top: 11.8rem;}
.round-s a{
    text-decoration: none;
    color:#4cb305;
    float: right;
    font-size: 14px;
    border: 1px solid#7b7b7b;
    padding: 5px 10px;
  
}

    </style>

