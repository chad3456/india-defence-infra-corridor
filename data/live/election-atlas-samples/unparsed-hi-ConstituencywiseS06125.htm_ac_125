                <tr>
                    <td valign='top' width='80%'>
                         <script language='javascript' type='text/javascript'>

                            function AddItem() {
                                ///Read the query string
                                var queryString = location.search.substring(1);
                                var constituencyCode = '';
                                var stateCode = '';
                                var pageURL = '';
                                if (queryString != null && queryString != '') {
                                    constituencyCode = queryString.split('=')[1];
                                }

                                var len = document.getElementById('ddlAC').options.length;
                                for (i = len - 1; i >= 0; i--) {
                                    var optiontoremove = document.getElementById('ddlAC').options[0];
                                    document.getElementById('ddlAC').removeChild(optiontoremove);
                                }

                                var opt = document.createElement('option');
                                document.getElementById('ddlAC').options.add(opt);
                                opt.text = 'Select Constituency';

                                var st = document.getElementById('ddlState');
                                var strValues = '';
                                
                                if (st.value == 'S06') 
                                   {
                                    strValues = document.getElementById('S06').value;
                                   }if (st.value == 'S08') 
                                   {
                                    strValues = document.getElementById('S08').value;
                                   } 
                                
                                stateCode = st.value;
                                var strac = strValues.split(';');
                                var i = 0;
                                for (i = 0; i < strac.length - 1; i++) {
                                    var AC = strac[i].split(',');
                                    var opt = document.createElement('option');
                                    document.getElementById('ddlAC').options.add(opt);
                                    opt.text = AC[1] + - + AC[0];
                                    opt.value = AC[0];
                                    if (constituencyCode != null && constituencyCode != '' && constituencyCode == TrimString(opt.value)) {
                                        document.getElementById('ddlAC').options[i + 1].selected = true;
                                    }
                                    else if (constituencyCode == null || constituencyCode == '') {
                                        document.getElementById('ddlAC').options[1].selected = true;
                                        constituencyCode = strac[0].split(',')[0];
                                    }
                                }
                                if (stateCode == 'Select State') {
                                    location.href = 'ConstituencywiseS2653.htm';
                                    return;
                                }
                                //if (parseInt(constituencyCode) > strac.length)
                                //    constituencyCode = strac[0].split(',')[0];
                                pageURL = 'Constituencywise' + TrimString(stateCode) + TrimString(constituencyCode) + '.htm';
                                if (pageURL != null && pageURL != '' && window.location.pathname.indexOf(pageURL) == -1)
                                    location.href = pageURL + '?ac=' + TrimString(constituencyCode);
                            }

                            function GetResult(ddlac) {
                                var ac = ddlac.value;
                                if (ac == 'Select Constituency' || ac == '')
                                    ac = ddlac.options[1].value; //IF option is select constituency then make first constituency selected
                                var st = document.getElementById('ddlState');
                                location.href = 'Constituencywise' + TrimString(st.value) + TrimString(ac) + '.htm?ac=' + TrimString(ac);
                            }

                            ///TO trim the leading and trailing space
                            function TrimString(value) {
                                if (typeof String.prototype.trim !== 'function') {
                                    return value.replace(/^\s+|\s+$/, '');
                                }
                                else
                                    return value.trim();
                            }

                            ///Set the first constituency name selected on state dropdown selection change.
                            function ChangeState(ddlState) {
                                var state = ddlState.value;
                                var strValues = '';
                                if (state == 'Select State' || state == '')
                                    state = ddlState.options[1].value; //IF option is select state then make first state selected

                                
                                if(state == 'S06') {
                                    strValues = document.getElementById('S06').value;
                                }if(state == 'S08') {
                                    strValues = document.getElementById('S08').value;
                                }
                                    
                                var strac = strValues.split(';');
                                location.href = 'Constituencywise' + TrimString(state) + TrimString(strac[0].split(',')[0]) + '.htm?ac=' + TrimString(strac[0].split(',')[0]);
                            }
                        </script>
                        <table style='margin: auto; width: 80%; font-family: Verdana; border: solid 1px black;
                        font-weight: lighter'>
                            <tbody><tr>
                                <td colspan='2' style='font-size: large;' align='center'>
                                    निर्वाचन क्षेत्रवार परिणाम की स्थिति
                                </td>
                            </tr>
 
                            <tr style='height: 20px; background-color: #FFC0CD; color: Black'>
                                <td style='width: 50%; font-weight: 700;' colspan='2' align='center'>
                                    <b>राज्य चुनें</b>
                                    <select name='' id='ddlState' onchange='return ChangeState(this);'>
                                        <option value='Select State'>राज्य चुनें</option>   
                                        
                                       <option value='S06' >गुजरात</option><option value='S08' >हिमाचल प्रदेश</option>
                                        
                                        
